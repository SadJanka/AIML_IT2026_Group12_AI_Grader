# Copy this file to .env (run.bat does it automatically). Restart the application after changing .env.

# Model that grades the submissions:
#   mock      - no AI, keyword matching only (demo, works immediately)
#   groq      - free Groq API (development and demos with made-up submissions only)
#   ollama    - local model on this computer (data never leaves it; use for real student work)
#   anthropic - Claude API (paid)
#   openai    - OpenAI or another OpenAI-compatible API (Mistral, Gemini, LM Studio)
LLM_PROVIDER=mock

# Groq (key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (https://ollama.com), first run: ollama pull gemma3:12b
# In Docker use OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI or a compatible API (e.g. Mistral: https://api.mistral.ai/v1, mistral-small-latest)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 0 keeps results repeatable for the same submission (fairness)
LLM_TEMPERATURE=0
LLM_TIMEOUT=180
# Retries after "too many requests" responses
LLM_MAX_RETRIES=5
LLM_MAX_WAIT=60
# Set to false if the API rejects response_format (JSON mode)
LLM_JSON_MODE=true

# Below this share of the points a criterion is weak and learning materials are suggested
WEAK_THRESHOLD=0.7

# Number of teacher corrections given to the AI as examples (when enabled for the assignment)
TEACHER_EXAMPLES=3
# Temperature of the second run when "Double check" is enabled
CHECK_TEMPERATURE=0.7

# Create a demo course on the first start
SEED_DEMO=true

# Database (default: SQLite file data/grader.db). MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/grader
